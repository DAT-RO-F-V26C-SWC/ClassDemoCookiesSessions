@page
@model SammeMedHTTPS.Pages.session.ShowKurvModel
@{
}

<h1>Kurvens indhold</h1>
<table class="table table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Navn</th>
            <th>Price</th>
            <th>Antal</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <form method="post">
            @foreach (var vare in Model.Kurv.AllVarer())
            {
            <tr>
                <td>@vare.Id</td>
                <td>@vare.Name</td>
                <td>@vare.Price</td>
                <td>@vare.Count</td>
                <td>
                    <input type="submit" asp-route-id="@vare.Id" asp-page-handler="plus" class="btn btn-success" value="+">
                </td>
                <td>
                    <input type="submit" asp-route-id="@vare.Id" asp-page-handler="minus" class="btn btn-danger" value="-">
                </td>
            </tr>
        }
        </form>
    </tbody>
</table>
